# Use your Gemini API key from Google AI Studio. NEVER commit .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-Gemini-key
GEMINI_MODEL=gemini-3.8-flash
# Optional alternative: set LLM_PROVIDER=openai and configure these instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
INTERNAL_API_KEY=replace-with-long-random-shared-secret
N8N_ENCRYPTION_KEY=replace-with-long-random-encryption-key
# Organizers said you can use your own account for judge access in this round.
GOOGLE_OWNER_EMAIL=syedaalizahassannaqvi@gmail.com
